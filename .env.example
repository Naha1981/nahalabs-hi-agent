# ---- Database (Supabase free tier or any Postgres) ----
# Runtime role: hi_app, subject to row-level security. Get from Supabase project settings.
DATABASE_URL=postgres://hi_app:...@host:5432/postgres
# Migrations only (owner role). Never given to the running app.
MIGRATE_DATABASE_URL=postgres://postgres:...@host:5432/postgres
# Password for the hi_app role: 20+ chars [A-Za-z0-9_-]. You invent it; store it in your secrets manager.
HI_APP_PASSWORD=20+ chars [A-Za-z0-9_-]
# Set to 'true' only when deliberately rotating the hi_app password during a migration.
FORCE_APP_PASSWORD=
# Optional tuning: pool size (default 5); DB_SSL=disable for a local Postgres without TLS.
DB_POOL_MAX=
DB_SSL=

# ---- Web sessions and signup ----
# Long random string; signs session CSRF tokens. You invent it.
SESSION_SECRET=long random string
# Long random string; authenticates the scheduler (/internal/run, /internal/stop). You invent it.
CRON_SECRET=long random string
# Comma-separated invite codes required at signup. You invent them; one per customer you onboard.
# (invite codes removed - open SaaS signup; no env needed)
# Optional: max signups per hour per instance (default 5).
SIGNUP_RATE_MAX=

# ---- Outbound email (Resend free tier: 100/day; nahalabs.co.za verified domain) ----
# resend.com -> API Keys. Free.
RESEND_API_KEY=
# Verified sender identity on your Resend domain.
MAIL_FROM="HI by NahaLabs <name@your-verified-domain>"
# Safety cap on outbound email per day (default 5).
HI_EMAIL_DAILY_CAP=5

# ---- Agent model (Groq free tier; console.groq.com -> API Keys) ----
GROQ_API_KEY=
# Optional overrides: default openai/gpt-oss-120b with openai/gpt-oss-20b fallback.
AGENT_MODEL=
AGENT_FALLBACK_MODEL=
# Tender fit-note model (default openai/gpt-oss-20b).
GROQ_MODEL=
# Set to 'false' to switch all model calls off without removing the key.
MODEL_ENABLED=
# Per-tenant daily caps (defaults: 80 agent calls, 20 fit notes).
AGENT_MAX_CALLS_PER_TENANT_DAY=
MODEL_MAX_CALLS_PER_TENANT_DAY=

# ---- Voice / Drive Companion (uses the same Groq account; free tier) ----
# Set to 'false' to switch voice turns off without removing the key.
VOICE_ENABLED=
# Defaults: whisper-large-v3-turbo (STT), canopylabs/orpheus-v1-english + voice austin (TTS).
# TTS model requires one-time terms acceptance in the Groq console by the org admin.
VOICE_STT_MODEL=
VOICE_TTS_MODEL=
VOICE_TTS_VOICE=
# Max audio bytes per voice turn (default 6 MB, about a minute of speech).
VOICE_MAX_BYTES=

# ---- Web search (self-hosted SearXNG, free; e.g. on Oracle Always Free) ----
# Base URL of your SearXNG instance, no trailing path. Agent web_search is off without it.
SEARX_URL=

# ---- Customer account connections (Google + Microsoft OAuth, free to register) ----
# Encrypts stored OAuth tokens: 32+ char random string. You invent it. Losing it orphans saved connections.
INTEGRATIONS_SECRET=
# console.cloud.google.com -> OAuth client (web). Redirect: $PUBLIC_BASE_URL/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# entra.microsoft.com -> app registration. Redirect: $PUBLIC_BASE_URL/integrations/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- Browser jobs (GitHub Actions runners, free within Actions minutes) ----
# Fine-grained PAT with actions:write on this repo, used to dispatch browser-job runs.
GITHUB_DISPATCH_TOKEN=
# Defaults to this repository.
GITHUB_REPO=Naha1981/nahalabs-hi-opportunity-desk
# Public URL of this deployment, e.g. https://nahalabs-hi.onrender.com (browser runners call back here).
PUBLIC_BASE_URL=
# Caps (defaults: 5 jobs/tenant/day, 300 jobs platform/month).
BROWSER_MAX_JOBS_PER_TENANT_DAY=
BROWSER_MAX_JOBS_PER_MONTH=

# ---- Phone bridge (opt-in paired Android phone) ----
# Max phone task proposals per account per day (default 10). Every task still needs approval in the queue.
PHONE_MAX_TASKS_PER_TENANT_DAY=

# ---- WhatsApp connector (official/permitted engines only) ----
# Shared secret the inbound webhook (/internal/wa/inbound) must present. You invent it.
WA_INBOUND_SECRET=
# Engine endpoint + key for sending replies (engine-agnostic adapter).
WA_ENGINE_URL=
WA_ENGINE_KEY=
# Reply cap (default 100/tenant/day).
WA_MAX_REPLIES_PER_TENANT_DAY=
# Meta Cloud API (official WhatsApp Business Platform) - engine meta_cloud
WA_META_PHONE_NUMBER_ID=
WA_META_TOKEN=
WA_META_VERIFY_TOKEN=
WA_META_APP_SECRET=

# ---- Tender ingest (National Treasury eTenders OCDS, open data, free) ----
# Override only for testing; default https://ocds-api.etenders.gov.za
ETENDERS_BASE=

# ---- Runtime ----
NODE_ENV=production
PORT=3000
