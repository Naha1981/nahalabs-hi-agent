# Runtime (hi_app role, subject to row-level security)
DATABASE_URL=postgres://hi_app:...@host:5432/postgres
# Migrations only (owner role). Never given to the running app.
MIGRATE_DATABASE_URL=postgres://postgres:...@host:5432/postgres
HI_APP_PASSWORD=20+ chars [A-Za-z0-9_-]
SESSION_SECRET=long random string
CRON_SECRET=long random string used by the scheduler
HI_INVITE_CODES=comma,separated,codes
RESEND_API_KEY=
MAIL_FROM="HI by NahaLabs <name@your-verified-domain>"
HI_EMAIL_DAILY_CAP=5
GROQ_API_KEY=            # optional: AI fit notes; leave empty to switch off
MODEL_MAX_CALLS_PER_TENANT_DAY=20
